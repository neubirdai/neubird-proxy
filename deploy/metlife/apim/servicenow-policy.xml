<!-- APIM policy for the ServiceNow API (backend: https://<proxy host>/_neubird/dest).
     Replace example.service-now.com with your instance. See README.md. -->
<policies>
  <inbound>
    <base />
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <set-header name="Authorization" exists-action="delete" />
    <set-header name="X-Neubird-Upstream-Authorization" exists-action="override">
      <value>{{servicenow-credential}}</value>
    </set-header>
    <set-header name="X-Neubird-Destination" exists-action="override">
      <value>https://example.service-now.com</value>
    </set-header>
    <set-header name="X-Neubird-Proxy-Token" exists-action="override">
      <value>{{neubird-proxy-token}}</value>
    </set-header>
    <authentication-certificate certificate-id="neubird-proxy-client" />
  </inbound>
  <backend>
    <forward-request timeout="120" />
  </backend>
  <outbound><base /></outbound>
  <on-error><base /></on-error>
</policies>
